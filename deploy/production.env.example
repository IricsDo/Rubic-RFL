# Container images published by .github/workflows/publish-images.yml.
# Use the immutable short-SHA tag emitted by the publish workflow.
RUBIC_FRONTEND_IMAGE=ghcr.io/owner/rubic-rfl/frontend:replace_with_published_short_sha
RUBIC_BACKEND_IMAGE=ghcr.io/owner/rubic-rfl/backend:replace_with_published_short_sha

# Public ports for a single-host deployment.
FRONTEND_PORT=80
BACKEND_PORT=8000
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# Replace before deployment.
POSTGRES_DB=rubic_rfl
POSTGRES_USER=rubic_rfl
POSTGRES_PASSWORD=replace_with_a_long_random_password

# Optional production monitoring profile credentials.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace_with_a_long_random_password
GRAFANA_ANONYMOUS_ENABLED=false

# Runtime configuration.
RUBIC_SESSION_STORAGE_BACKEND=postgres
RUBIC_RL_MODEL_FILE=lightweight-linear-axis-samples-28-heldout/linear-policy.npz
RUBIC_RL_POLICY_TYPE=auto
RUBIC_RL_POLICY_DEVICE=cpu
RUBIC_RL_MAX_STEPS=30
RUBIC_RL_SEARCH_WIDTH=5
RUBIC_RL_SEARCH_TOP_K=5
RUBIC_RL_SEARCH_TRACE_LIMIT=200
