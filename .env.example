# Local Docker Compose defaults.
FRONTEND_PORT=5173
BACKEND_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379

# Development database settings. Replace before using outside local dev.
POSTGRES_DB=rubic_rfl
POSTGRES_USER=rubic_rfl
POSTGRES_PASSWORD=rubic_rfl_dev_password

# Optional RL checkpoint mounted from ./checkpoints into /models.
RUBIC_RL_MODEL_FILE=mlp-baseline-depth-1-2-3.npz
RUBIC_RL_MAX_STEPS=30
RUBIC_RL_SEARCH_WIDTH=5
RUBIC_RL_SEARCH_TOP_K=5
RUBIC_RL_SEARCH_TRACE_LIMIT=200

