# Local Docker Compose defaults.
FRONTEND_PORT=5173
BACKEND_PORT=8000
# Used only with docker-compose.host-ports.yml. The default stack keeps
# PostgreSQL and Redis private to the Compose network.
POSTGRES_PORT=5433
REDIS_PORT=6379
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# Development database settings. Replace before using outside local dev.
POSTGRES_DB=rubic_rfl
POSTGRES_USER=rubic_rfl
POSTGRES_PASSWORD=rubic_rfl_dev_password

# Local monitoring dashboard credentials. Replace before exposing Grafana.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_ANONYMOUS_ENABLED=false

# Session persistence. Auto uses DATABASE_URL when present; use "files" for
# JSON fallback storage.
RUBIC_SESSION_STORAGE_BACKEND=postgres

# Optional RL checkpoint mounted from ./checkpoints into /models.
RUBIC_RL_MODEL_FILE=mlp-baseline-depth-1-2-3.npz
RUBIC_RL_MAX_STEPS=30
RUBIC_RL_SEARCH_WIDTH=5
RUBIC_RL_SEARCH_TOP_K=5
RUBIC_RL_SEARCH_TRACE_LIMIT=200
